#!/usr/bin/env python3
"""Post an image to Herdr's Show panel.

  herdr-show <image> [--title "Landing page v2"] [--fixes <id>|last] [--name NAME]
  herdr-show mark <spec.json>      (used by the Show panel to save a markup)
  herdr-show last                  (id of the newest marked-up image)
"""
import argparse
import json
import os
import secrets
import shutil
import subprocess
import sys
import time
from pathlib import Path

HOME = Path(os.environ.get("HERDR_APP_HOME", Path.home() / ".config" / "herdr-app"))
STORE = HOME / "show"
ITEMS = STORE / "items"
IMAGES = STORE / "img"
RENDER_SRC = HOME / "mods" / "show" / "render.swift"
RENDER_BIN = Path.home() / ".cache" / "herdr-show" / "render"


def new_id():
    return time.strftime("%Y%m%d-%H%M%S") + "-" + secrets.token_hex(2)


def items():
    out = []
    for f in ITEMS.glob("*.json"):
        try:
            out.append(json.loads(f.read_text()))
        except (OSError, ValueError):
            pass
    return sorted(out, key=lambda i: i.get("time", 0))


def load(item_id):
    f = ITEMS / f"{item_id}.json"
    if not f.exists():
        sys.exit(f"herdr-show: no item {item_id}")
    return json.loads(f.read_text())


def save(item):
    tmp = ITEMS / f".{item['id']}.json.tmp"
    tmp.write_text(json.dumps(item, indent=2))
    tmp.replace(ITEMS / f"{item['id']}.json")


def size_of(path):
    r = subprocess.run(["sips", "-g", "pixelWidth", "-g", "pixelHeight", str(path)], capture_output=True, text=True)
    dims = {}
    for line in r.stdout.splitlines():
        parts = line.strip().split(": ")
        if len(parts) == 2 and parts[0] in ("pixelWidth", "pixelHeight"):
            dims[parts[0]] = int(parts[1])
    if len(dims) != 2:
        sys.exit(f"herdr-show: not an image: {path}")
    return dims["pixelWidth"], dims["pixelHeight"]


def project_of(cwd):
    r = subprocess.run(["git", "rev-parse", "--show-toplevel"], cwd=cwd, capture_output=True, text=True)
    return Path(r.stdout.strip() if r.returncode == 0 else cwd).name or "~"


def renderer():
    if not RENDER_BIN.exists() or RENDER_BIN.stat().st_mtime < RENDER_SRC.stat().st_mtime:
        RENDER_BIN.parent.mkdir(parents=True, exist_ok=True)
        r = subprocess.run(["swiftc", "-O", "-o", str(RENDER_BIN), str(RENDER_SRC)], capture_output=True, text=True)
        if r.returncode != 0:
            sys.exit("herdr-show: renderer failed to compile:\n" + r.stderr)
    return RENDER_BIN


def with_suffix(name, suffix):
    stem = Path(name).stem
    for old in (".marked", ".fixed"):
        if stem.endswith(old):
            stem = stem[: -len(old)]
    return f"{stem}.{suffix}.png" if suffix else f"{stem}.png"


def post(args):
    src = Path(args.image).expanduser().resolve()
    if not src.is_file():
        sys.exit(f"herdr-show: no such file: {src}")
    parent = None
    if args.fixes:
        if args.fixes == "last":
            marked = [i for i in items() if i.get("kind") == "marked"]
            if not marked:
                sys.exit("herdr-show: no marked-up image to fix")
            parent = marked[-1]
        else:
            parent = load(args.fixes)
    item_id = new_id()
    ext = src.suffix.lower() or ".png"
    dest = IMAGES / f"{item_id}{ext}"
    shutil.copyfile(src, dest)
    width, height = size_of(dest)
    cwd = os.getcwd()
    item = {
        "id": item_id,
        "name": args.name or (with_suffix(parent["name"], "fixed") if parent else src.name),
        "kind": "fixed" if parent else "shown",
        "file": f"show/img/{dest.name}",
        "path": str(dest),
        "source": str(src),
        "width": width,
        "height": height,
        "project": parent["project"] if parent else project_of(cwd),
        "cwd": cwd,
        "terminal": os.environ.get("HC_TERMINAL_ID") or (parent or {}).get("terminal"),
        "title": args.title or (parent or {}).get("title"),
        "parent": parent["id"] if parent else None,
        "root": parent.get("root", parent["id"]) if parent else item_id,
        "time": int(time.time() * 1000),
    }
    save(item)
    print(json.dumps({"id": item_id, "path": str(dest)}))


def mark(spec_path):
    spec = json.loads(Path(spec_path).read_text())
    parent = load(spec["parent"])
    item_id = new_id()
    dest = IMAGES / f"{item_id}.png"
    render_spec = STORE / "tmp" / f"{item_id}.render.json"
    render_spec.write_text(json.dumps({"src": parent["path"], "out": str(dest), "shapes": spec["shapes"]}))
    r = subprocess.run([str(renderer()), str(render_spec)], capture_output=True, text=True)
    render_spec.unlink(missing_ok=True)
    if r.returncode != 0:
        sys.exit("herdr-show: render failed: " + r.stderr.strip())
    item = {
        **{k: parent.get(k) for k in ("project", "cwd", "terminal", "title", "width", "height")},
        "id": item_id,
        "name": with_suffix(parent["name"], "marked"),
        "kind": "marked",
        "file": f"show/img/{dest.name}",
        "path": str(dest),
        "parent": parent["id"],
        "root": parent.get("root", parent["id"]),
        "note": spec.get("note") or "",
        "shapes": spec["shapes"],
        "time": int(time.time() * 1000),
    }
    save(item)
    print(json.dumps(item))


def main():
    for d in (ITEMS, IMAGES, STORE / "tmp"):
        d.mkdir(parents=True, exist_ok=True)
    argv = sys.argv[1:]
    if argv[:1] == ["mark"] and len(argv) == 2:
        return mark(argv[1])
    if argv == ["last"]:
        marked = [i for i in items() if i.get("kind") == "marked"]
        return print(marked[-1]["id"] if marked else "")
    p = argparse.ArgumentParser(prog="herdr-show", description="Post an image to Herdr's Show panel.")
    p.add_argument("image")
    p.add_argument("--title", help="what the image is of, e.g. 'Landing page v2'")
    p.add_argument("--fixes", metavar="ID", help="the marked-up image this one fixes, or 'last'")
    p.add_argument("--name", help="name shown in the panel (default: the file's name)")
    post(p.parse_args(argv))


if __name__ == "__main__":
    main()
