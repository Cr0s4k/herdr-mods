#!/usr/bin/env python3
"""Persist agent handoffs for Herdr's Since you left panel."""
import argparse
import json
import os
import re
import secrets
import subprocess
import sys
import time
from pathlib import Path


def store():
    return Path(os.environ.get("HERDR_APP_HOME", Path.home() / ".config/herdr-app")) / "brief/items"


def command_json(argv):
    result = subprocess.run(argv, capture_output=True, text=True, timeout=5)
    if result.returncode:
        raise ValueError(f"{argv[0]} could not read the current session.")
    return json.loads(result.stdout)


def destination(spaces, terminals, cwd, terminal=None):
    """Use identity first; directory fallback must identify one live worker."""
    if not terminal:
        workers = [item for item in terminals if item.get("cwd") == cwd
                   and item.get("state") == "live" and item.get("status") == "working"]
        if len(workers) != 1:
            raise ValueError("Cannot identify one working agent in this folder. Pass --terminal with your exact terminal address.")
        terminal = workers[0]["address"]
    matches = [space for space in spaces for tab in space.get("tabs", [])
               if any(item.get("terminal") == terminal for item in tab.get("terminals", []))]
    if len(matches) != 1:
        raise ValueError("The terminal does not identify one Herdr space. No handoff was posted.")
    return matches[0]["id"], terminal


def validate(item):
    if not isinstance(item, dict) or item.get("source") != "agent":
        raise ValueError("Invalid handoff")
    for key in ("id", "space", "terminal", "title", "summary"):
        if not isinstance(item.get(key), str) or not item[key].strip() or len(item[key]) > 12000:
            raise ValueError(f"Invalid {key}")
    if not isinstance(item.get("time"), int) or item["time"] < 0:
        raise ValueError("Invalid time")
    for key in ("changes", "tests", "questions", "caveats"):
        # Caveats were added later; existing handoffs remain valid without them.
        values = item.get(key, []) if key == "caveats" else item.get(key)
        if not isinstance(values, list) or len(values) > 30 or any(
                not isinstance(value, str) or not value.strip() or len(value) > 12000 for value in values):
            raise ValueError(f"Invalid {key}")
    return item


def post(args):
    cwd = str(Path(args.cwd or os.getcwd()).resolve())
    identity = args.terminal or os.environ.get("HC_TERMINAL_ID")
    layout = command_json(["herdr-app", "ls"])
    terminals = [] if identity else command_json(["hc", "ls", "--json"])["terminals"]
    space, terminal = destination(layout["spaces"], terminals, cwd, identity)
    item = validate({"id": f"handoff-{time.time_ns()}-{secrets.token_hex(4)}",
                     "space": space, "terminal": terminal, "cwd": cwd,
                     "time": int(time.time() * 1000), "source": "agent", "kind": "handoff",
                     "title": args.title.strip(), "summary": args.summary.strip(),
                     "changes": args.change, "tests": args.test, "questions": args.question,
                     "caveats": args.caveat})
    save(item)
    return {"id": item["id"], "space": space}


def save(item):
    root = store()
    root.mkdir(parents=True, exist_ok=True)
    target = root / f"{item['id']}.json"
    temporary = target.with_suffix(".tmp")
    try:
        temporary.write_text(json.dumps(item, ensure_ascii=False), encoding="utf-8")
        temporary.replace(target)
    finally:
        temporary.unlink(missing_ok=True)


TAIL = 512_000


def rows(file):
    with open(file, "rb") as handle:
        handle.seek(max(0, file.stat().st_size - TAIL))
        for line in handle.read().decode("utf-8", "replace").splitlines():
            try:
                row = json.loads(line)
            except ValueError:
                continue
            if isinstance(row, dict):
                yield row


def text_of(content):
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        return "\n\n".join(part["text"] for part in content if isinstance(part, dict) and isinstance(part.get("text"), str) and part["text"].strip())
    return ""


def claude_reply(turn, home=None):
    """The last thing the Claude Code running as this process said, from the conversation it has open."""
    base = Path(home or os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude")
    try:
        session = json.loads((base / "sessions" / f"{turn['pid']}.json").read_text())
        file = base / "projects" / re.sub(r"[^A-Za-z0-9]", "-", session["cwd"]) / f"{session['sessionId']}.jsonl"
        said = [text_of((row.get("message") or {}).get("content")) for row in rows(file) if row.get("type") == "assistant" and not row.get("isSidechain")]
    except (OSError, ValueError, KeyError, TypeError):
        return None
    return next((text for text in reversed(said) if text.strip()), None)


def codex_reply(turn, home=None):
    """The last thing Codex said in the conversation of this folder that changed during the turn."""
    base = Path(home or os.environ.get("CODEX_HOME") or Path.home() / ".codex") / "sessions"
    files = sorted((file for file in base.glob("*/*/*/*.jsonl") if file.stat().st_mtime * 1000 >= turn["since"]), key=lambda file: file.stat().st_mtime, reverse=True)
    for file in files[:20]:
        with open(file, encoding="utf-8", errors="replace") as handle:
            try:
                meta = json.loads(handle.readline()).get("payload") or {}
            except ValueError:
                continue
        if meta.get("cwd") != turn.get("cwd"):
            continue
        said = [text_of(row["payload"].get("content")) for row in rows(file)
                if row.get("type") == "response_item" and isinstance(row.get("payload"), dict) and row["payload"].get("role") == "assistant"]
        return next((text for text in reversed(said) if text.strip()), None)
    return None


def shape(text):
    """A reply as a brief: its first paragraph, the rest behind Read more, and a closing question as one to answer."""
    paragraphs = [part.strip() for part in re.split(r"\n\s*\n", text.strip()) if part.strip()]
    question = paragraphs.pop() if len(paragraphs) > 1 and paragraphs[-1].endswith("?") and len(paragraphs[-1]) <= 600 else None
    summary, rest = paragraphs[0], "\n\n".join(paragraphs[1:])
    return {"summary": summary if len(summary) <= 600 else summary[:600].rstrip() + "…",
            "changes": [rest if len(rest) <= 6000 else rest[:6000].rstrip() + "…"] if rest else [],
            "questions": [question] if question else []}


def wrap(turn, claude_home=None, codex_home=None):
    """Leave a brief from the agent's last reply for a turn that ended unseen, unless the agent left one during it."""
    if any(item["terminal"] == turn["terminal"] and item["time"] >= turn["since"] for item in listing()["items"]):
        return {"skipped": "The agent left its own brief."}
    reply = claude_reply(turn, claude_home) if turn.get("agent") == "claude" else codex_reply(turn, codex_home) if turn.get("agent") == "codex" else None
    if not reply:
        return {"skipped": "No reply could be read."}
    item = validate({"id": f"handoff-{time.time_ns()}-{secrets.token_hex(4)}", "space": turn["space"], "terminal": turn["terminal"],
                     "cwd": turn.get("cwd"), "time": int(turn["time"]), "source": "agent", "kind": "reply", "auto": True,
                     "title": str(turn.get("title") or "Agent").strip()[:200], "tests": [], "caveats": [], **shape(reply)})
    save(item)
    return {"id": item["id"], "space": item["space"]}


def listing():
    items, failed = [], 0
    root = store()
    if root.exists():
        # Files are immutable and uniquely named; concurrent writers never share
        # a temporary path and readers only see atomically published JSON.
        for path in sorted(root.glob("*.json"), reverse=True)[:500]:
            try:
                items.append(validate(json.loads(path.read_text(encoding="utf-8"))))
            except (OSError, ValueError, TypeError):
                failed += 1
    return {"items": sorted(items, key=lambda item: (item["time"], item["id"]), reverse=True),
            "warning": f"{failed} handoff file(s) could not be read. Other updates are still shown." if failed else None}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("list", help="Read saved handoffs as JSON")
    wrapping = commands.add_parser("wrap", help="Herdr's own: leave a brief from an agent's last reply")
    wrapping.add_argument("turn", help="JSON: space, terminal, title, agent, since, time, pid, cwd")
    posting = commands.add_parser("post", help="Leave a handoff for your own space")
    posting.add_argument("--title", required=True)
    posting.add_argument("--summary", required=True)
    for field in ("change", "test", "question", "caveat"):
        posting.add_argument(f"--{field}", action="append", default=[])
    posting.add_argument("--terminal", help="Exact terminal address; never the focused terminal")
    posting.add_argument("--cwd", help="Task's working folder")
    args = parser.parse_args()
    try:
        print(json.dumps(listing() if args.command == "list" else wrap(json.loads(args.turn)) if args.command == "wrap" else post(args)))
    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as error:
        print(json.dumps({"error": str(error)}))
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
