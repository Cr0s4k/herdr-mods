#!/usr/bin/env python3
"""Read Linear through its official MCP server. Credentials never leave this process."""
import argparse
import getpass
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import urllib.error
import urllib.request

ENDPOINT = "https://mcp.linear.app/mcp"
FIELDS = ["id", "uuid", "title", "status", "statusType", "assignee", "assigneeId",
          "team", "project", "priority", "url", "updatedAt"]


class LinearError(Exception):
    def __init__(self, message, kind="request"):
        super().__init__(message)
        self.kind = kind


def credential(app_home):
    token = os.environ.get("LINEAR_API_KEY", "").strip()
    if token:
        return token, "API key"
    path = Path(app_home) / "linear" / "credentials.json"
    if path.exists():
        try:
            token = json.loads(path.read_text()).get("apiKey", "").strip()
        except (OSError, ValueError, AttributeError):
            raise LinearError("Cannot read the saved connection. Connect Linear again.", "auth")
        if token:
            return token, "API key"
    # Use Claude's existing login without copying, refreshing, or changing its credentials.
    candidates = []
    claude_home = Path(os.environ.get("CLAUDE_CONFIG_DIR", Path.home() / ".claude"))
    path = claude_home / ".credentials.json"
    if path.exists():
        try:
            candidates.append(json.loads(path.read_text()))
        except (OSError, ValueError):
            pass
    if sys.platform == "darwin":
        try:
            result = subprocess.run(["security", "find-generic-password", "-s", "Claude Code-credentials", "-w"],
                                    capture_output=True, text=True, timeout=5)
            if result.returncode == 0:
                candidates.append(json.loads(result.stdout))
        except (OSError, ValueError, subprocess.TimeoutExpired):
            pass
    entries = [entry for data in candidates for entry in data.get("mcpOAuth", {}).values()
               if isinstance(entry, dict) and entry.get("serverUrl", "").rstrip("/") in
               (ENDPOINT, ENDPOINT + "/readonly") and entry.get("accessToken")]
    if entries:
        entry = max(entries, key=lambda item: item.get("expiresAt", 0) or 0)
        return entry["accessToken"], "Claude login"
    raise LinearError("Connect Linear to browse your tickets.", "auth")


def parse_rpc(raw):
    # Streamable HTTP may return either JSON or a stream containing a JSON-RPC event.
    try:
        data = json.loads(raw)
    except ValueError:
        data = None
        for event in raw.replace("\r\n", "\n").split("\n\n"):
            payload = "\n".join(line[5:].lstrip() for line in event.splitlines() if line.startswith("data:"))
            if payload:
                try:
                    candidate = json.loads(payload)
                    if candidate.get("id") == 1:
                        data = candidate
                except ValueError:
                    continue
        if data is None:
            raise LinearError("Linear returned an unreadable response. Try refreshing.")
    if data.get("error"):
        raise LinearError("Linear could not complete the request. Try refreshing.")
    result = data.get("result", {})
    if result.get("isError"):
        # Do not echo arbitrary transport output, which could contain credential details.
        raise LinearError("Linear could not load these tickets. Check the search or project and retry.")
    if isinstance(result.get("structuredContent"), dict):
        return result["structuredContent"]
    for block in result.get("content", []):
        if block.get("type") == "text":
            try:
                return json.loads(block["text"])
            except ValueError:
                continue
    raise LinearError("Linear returned an unsupported response. Try refreshing.")


def call(token, name, arguments):
    if name not in {"list_issues", "get_issue", "list_projects", "list_issue_statuses", "get_user"}:
        raise LinearError("Unsupported Linear operation.")
    body = {"jsonrpc": "2.0", "id": 1, "method": "tools/call",
            "params": {"name": name, "arguments": arguments}}
    req = urllib.request.Request(ENDPOINT, data=json.dumps(body).encode(), headers={
        "Authorization": "Bearer " + token, "Content-Type": "application/json",
        "Accept": "application/json, text/event-stream"})
    try:
        with urllib.request.urlopen(req, timeout=20) as response:
            return parse_rpc(response.read(4 * 1024 * 1024).decode())
    except urllib.error.HTTPError as error:
        if error.code in (401, 403):
            raise LinearError("Your Linear connection needs attention. Reconnect in Claude with /mcp, or connect an API key below.", "auth")
        if error.code == 429:
            raise LinearError("Linear is rate limiting requests. Wait a moment, then refresh.", "rate_limit")
        raise LinearError("Linear is unavailable. Try refreshing in a moment.")
    except (urllib.error.URLError, TimeoutError, OSError):
        raise LinearError("Cannot reach Linear. Check your connection, then refresh.")


def request(app_home, payload):
    token, source = credential(app_home)
    operation = payload.get("op", "issues")
    if operation == "issues":
        args = {"limit": 50, "fields": FIELDS, "includeArchived": False, "orderBy": "updatedAt"}
        if payload.get("scope") == "mine":
            args["assignee"] = "me"
        elif payload.get("scope") == "unassigned":
            args["assignee"] = "null"
        for key in ("query", "project", "cursor", "state"):
            if payload.get(key):
                args[key] = payload[key]
        if payload.get("open"):
            issues = {}
            for kind in ("started", "unstarted", "backlog"):
                page = call(token, "list_issues", {**args, "state": kind})
                if not isinstance(page.get("issues"), list):
                    raise LinearError("Linear did not return a ticket list. Refresh to try again.")
                for issue in page["issues"]:
                    issues.setdefault(issue.get("uuid") or issue.get("id"), issue)
            data = {"issues": list(issues.values()), "hasNextPage": False}
        else:
            data = call(token, "list_issues", args)
        if not isinstance(data.get("issues"), list):
            raise LinearError("Linear did not return a ticket list. Refresh to try again.")
    elif operation == "detail":
        data = call(token, "get_issue", {"id": payload["id"], "includeRelations": True})
        if not data.get("id") or not data.get("title"):
            raise LinearError("This ticket is no longer available. Refresh the list.")
    elif operation == "details":
        issues = []
        for issue_id in [str(issue_id) for issue_id in payload.get("ids", []) if issue_id][:10]:
            try:
                issue = call(token, "get_issue", {"id": issue_id})
            except LinearError as error:
                if error.kind != "request":
                    raise
                continue
            if issue.get("id") and issue.get("title"):
                issues.append(issue)
        data = {"issues": issues}
    elif operation == "states":
        states = {}
        for team in [str(team) for team in payload.get("teams", []) if team][:5]:
            rows = call(token, "list_issue_statuses", {"team": team})
            for row in rows if isinstance(rows, list) else rows.get("statuses", []) if isinstance(rows, dict) else []:
                if isinstance(row, dict) and row.get("name"):
                    states.setdefault(row["name"], {"id": row["name"], "name": row["name"], "type": row.get("type", "backlog")})
        data = {"states": list(states.values())}
    elif operation == "projects":
        args = {"limit": 50, "fields": ["id", "uuid", "name"]}
        for key in ("query", "cursor"):
            if payload.get(key):
                args[key] = payload[key]
        data = call(token, "list_projects", args)
    else:
        raise LinearError("Unsupported Linear operation.")
    return {"data": data, "source": source}


def connect(app_home):
    print("Connect Linear\n\nCreate a personal API key with Read permission at:\nhttps://linear.app/settings/account/security\n")
    token = getpass.getpass("Paste your API key (hidden): ").strip()
    if not token:
        raise LinearError("No key entered. Your existing connection was kept.", "auth")
    call(token, "get_user", {"query": "me"})
    folder = Path(app_home) / "linear"
    folder.mkdir(parents=True, exist_ok=True, mode=0o700)
    descriptor, temporary = tempfile.mkstemp(dir=folder, prefix=".credentials-")
    try:
        with os.fdopen(descriptor, "w") as file:
            json.dump({"apiKey": token}, file)
        os.replace(temporary, folder / "credentials.json")
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)
    print("\nConnected. Return to the Linear panel and click Refresh.")
    input("Press Enter to close this tab.")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--home", default=os.environ.get("HERDR_APP_HOME", str(Path.home() / ".config/herdr-app")))
    parser.add_argument("command", choices=["request", "connect"])
    parser.add_argument("payload", nargs="?", default="{}")
    args = parser.parse_args()
    try:
        if args.command == "connect":
            connect(args.home)
        else:
            print(json.dumps(request(args.home, json.loads(args.payload))))
    except (LinearError, ValueError, KeyError, EOFError, KeyboardInterrupt) as error:
        message = str(error) if isinstance(error, LinearError) else "Could not read the Linear request. Try again."
        if args.command == "connect":
            print(message, file=sys.stderr)
        else:
            print(json.dumps({"error": message, "kind": getattr(error, "kind", "request")}))
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
